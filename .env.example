# Tạo file .env cục bộ (đã được .gitignore bảo vệ) để cấu hình bí mật.

# 1. KẾT NỐI DATABASE SUPABASE DEV (Direct Connection - IPv6 Port 5432)
# Dành cho Prisma CLI, migration và introspection
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.rgoqdykpqyedambkrlvr.supabase.co:5432/postgres"

# Dành cho direct execution nếu dùng transaction pooler
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.rgoqdykpqyedambkrlvr.supabase.co:5432/postgres"

# 2. SUPABASE PROJECT IDENTIFIERS
NEXT_PUBLIC_SUPABASE_PROJECT_ID="rgoqdykpqyedambkrlvr"
